run = "python -m bot.main"
entrypoint = "bot/main.py"
modules = ["python-3.12"]

[env]
PYTHONUNBUFFERED = "1"

[[ports]]
localPort = 8080
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
DB_PATH = "data/bot.db"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m bot.main"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"
